---
import Navbar from "./navbar.astro";
---

<header>
  <div class="bar">
    <p class="logo">andrew&nbsp;zhang</p>
    <Navbar />
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: var(--light-deep);
    box-shadow: 0 1px 0 var(--shadow);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-width: 100ch;
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }

  .logo {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--dark);
  }
</style>

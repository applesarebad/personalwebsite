---
import Navbar from './navbar.astro';
---
<style>
  :global(body) { margin: 0; }
  header {
    width: 100%;
    background-color: var(--blush-deep);
    box-shadow: 0 1px 0 var(--blush-soft);
    z-index: 100;
    position: fixed;
    top: 0;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 100ch;
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }
  .logo {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--plum);
  }
  .header-spacer {
    height: 5rem;
  }
</style>

<header>
  <nav>
    <p class="logo">andrew&nbsp;zhang</p>
    <Navbar />
  </nav>
</header>
<div class="header-spacer"></div>
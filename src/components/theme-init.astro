---
import { getImage } from "astro:assets";
import { paintings } from "../data/paintings.js";

const resolved = await Promise.all(
  paintings.map(async ({ image, ...painting }) => {
    const optimised = await getImage({
      src: image,
      width: 2400,
      format: "webp",
      quality: 72,
    });
    return { ...painting, src: optimised.src };
  })
);
---

<script define:vars={{ paintings: resolved }}>
  (function () {
    const EXPLICIT_KEY = "themeChoice"; // localStorage: a manual pick, sticky across visits
    const SESSION_KEY = "themeChoice"; // sessionStorage: this browsing session's roll

    function getMood(date) {
      const hour = date.getHours();
      if (hour >= 4 && hour < 10) return "dawn";
      if (hour >= 10 && hour < 16) return "day";
      if (hour >= 16 && hour < 22) return "dusk";
      return "night";
    }

    function toCssVarName(key) {
      return "--" + key.replace(/([A-Z])/g, "-$1").toLowerCase();
    }

    function byId(id) {
      return id ? paintings.find((p) => p.id === id) : undefined;
    }

    function read(storage, key) {
      try {
        return storage.getItem(key);
      } catch {
        return null;
      }
    }

    function write(storage, key, value) {
      try {
        storage.setItem(key, value);
      } catch {}
    }

    function remove(storage, key) {
      try {
        storage.removeItem(key);
      } catch {}
    }

    function applyTheme(painting) {
      const root = document.documentElement;
      Object.entries(painting.vars).forEach(([key, value]) => {
        root.style.setProperty(toCssVarName(key), value);
      });
      root.style.setProperty("--hero-image", `url("${painting.src}")`);
      root.dataset.paintingId = painting.id;
      window.__activePainting = painting;
      window.dispatchEvent(
        new CustomEvent("theme-applied", { detail: painting })
      );
    }

    function pick() {
      const isHome =
        window.location.pathname === "/" ||
        window.location.pathname === "/index.html";

      if (!isHome) {
        const explicit = byId(read(localStorage, EXPLICIT_KEY));
        if (explicit) return explicit;

        const session = byId(read(sessionStorage, SESSION_KEY));
        if (session) return session;
      }

      const mood = getMood(new Date());
      const matches = paintings.filter((p) => p.mood === mood);
      const pool = matches.length ? matches : paintings;
      const chosen = pool[Math.floor(Math.random() * pool.length)];
      remove(localStorage, EXPLICIT_KEY);
      write(sessionStorage, SESSION_KEY, chosen.id);
      return chosen;
    }

    applyTheme(pick());

    window.__cycleTheme = function () {
      const currentId = document.documentElement.dataset.paintingId;
      const index = paintings.findIndex((p) => p.id === currentId);
      const next = paintings[(index + 1) % paintings.length];
      write(localStorage, EXPLICIT_KEY, next.id);
      applyTheme(next);
      return next;
    };
  })();
</script>

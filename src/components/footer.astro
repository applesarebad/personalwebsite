---
const year = new Date().getFullYear();

const socials = [
  {
    href: "https://github.com/applesarebad",
    icon: "mdi:github",
    label: "GitHub",
  },
  {
    href: "https://www.linkedin.com/in/andrew-zhang-b25783357/",
    icon: "mdi:linkedin",
    label: "LinkedIn",
  },
];
---

<footer>
  <p>andrewzhang927@gmail.com</p>
  <div class="icons">
    {
      socials.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
        >
          <span class="iconify" data-icon={social.icon} />
        </a>
      ))
    }
  </div>
  <p>andrew zhang {year}</p>
</footer>

<style>
  footer {
    text-align: center;
    background: var(--light-deep);
    padding: 2rem 1rem 2.5rem;
    margin-top: 3rem;
  }

  p {
    color: var(--dark-soft);
    font-size: 0.85rem;
    margin: 0.35rem 0;
  }

  .icons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 0.75rem 0;
  }
</style>

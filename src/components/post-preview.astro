---
import TagCell from "./tag-cell.astro";

interface Props {
  title: string;
  url: string;
  date?: string;
  tags?: string[];
  description?: string;
}

const { title, url, date, tags = [], description } = Astro.props;
---

<a class="post-link" href={url}>
  <article class="surface post" onclick={`location.href='${url}'`}>
    <div class="rowone">
      <h2>{title}</h2>
      <h4>{date}</h4>
    </div>
    {description && <p>{description}</p>}
    {
      tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <TagCell tag={tag} base="/blog" />
          ))}
        </div>
      )
    }
  </article>
</a>

<style>
  .post-link {
    text-decoration: none;
    display: block;
  }

  .post {
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  .rowone {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  h2 {
    font-family: var(--font-sans);
    font-size: 1.4rem;
    margin: 0;
    color: var(--dark);
    word-break: break-word;
  }

  h4 {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: normal;
    margin: 0;
    color: var(--dark-soft);
    white-space: nowrap;
  }

  p {
    margin: 0.5rem 0 0;
    color: var(--dark-soft);
    word-break: break-word;
    max-width: 100%;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.25rem;
    margin-top: 0.75rem;
  }
</style>

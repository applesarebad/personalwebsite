---
interface Props {
  tag: string;

  base?: string;
}

const { tag, base } = Astro.props;

const section = Astro.url.pathname.split("/")[1];
const destination =
  base ?? (section === "blog" || section === "posts" ? "/blog" : "/projects");

const PALETTE = [
  [255, 169, 169],
  [255, 169, 227],
  [227, 169, 255],
  [169, 169, 255],
  [169, 227, 255],
  [169, 255, 227],
  [169, 255, 169],
  [227, 255, 169],
  [255, 227, 169],
];

const firstLetter = tag.trim().charAt(0).toLowerCase();
const group = /[a-z]/.test(firstLetter)
  ? Math.min(Math.floor((firstLetter.charCodeAt(0) - 97) / 3), PALETTE.length - 1)
  : PALETTE.length - 1;
const [r, g, b] = PALETTE[group];
---

<a href={`${destination}/${encodeURIComponent(tag)}`}>
  <span class="cell">{tag}</span>
</a>

<style define:vars={{ r, g, b }}>
  .cell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    background-color: rgb(var(--r), var(--g), var(--b));
    text-decoration: none;
    padding: 0.25rem 1rem;
    font-size: 0.9rem;
  }

  a {
    text-decoration: none;
    color: black;
  }
</style>

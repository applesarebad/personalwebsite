---
import TagCell from "./tag-cell.astro";

interface Props {
  title: string;
  url: string;
  tags?: string[];
  description?: string;
}

const { title, url, tags = [], description } = Astro.props;
---

<a class="post-link" href={url}>
  <article class="surface post" onclick={`location.href='${url}'`}>
    <h2>{title}</h2>
    {
      tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <TagCell tag={tag} base="/projects" />
          ))}
        </div>
      )
    }
    {description && <p class="description">{description}</p>}
  </article>
</a>

<style>
  .post-link {
    text-decoration: none;
    display: contents;
  }

  .post {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 1.25rem;
    min-height: 140px;
  }

  h2 {
    font-family: var(--font-sans);
    font-size: 1.3rem;
    margin: 0;
    color: var(--dark);
    word-break: break-word;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .description {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    margin: 0.5rem 0 0 0;
    color: var(--dark-soft);
  }
</style>

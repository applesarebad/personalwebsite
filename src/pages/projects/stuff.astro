---
import Bloglayout from "../../layouts/bloglayout.astro";
import WorkPreview from "../../components/work-preview.astro";
import TagCell from "../../components/tag-cell.astro";
import { loadPosts, collectTags } from "../../lib/posts";

const posts = loadPosts(import.meta.glob("../stuff/*.md", { eager: true }));
const favourites = posts.filter((post) => post.frontmatter.favourite);
const tags = collectTags(posts);

const socials = [
  {
    href: "https://github.com/applesarebad",
    icon: "mdi:github",
    label: "GitHub",
  },
  {
    href: "https://www.youtube.com/@waterycheesecake",
    icon: "mdi:youtube",
    label: "YouTube",
  },
  {
    href: "https://applesarebad.itch.io/",
    icon: "simple-icons:itchdotio",
    label: "itch.io",
  },
  {
    href: "https://www.linkedin.com/in/andrew-zhang-b25783357/",
    icon: "mdi:linkedin",
    label: "LinkedIn",
  },
];
---

<Bloglayout
  title="projects | Andrew Zhang"
  description="Games, websites and other things Andrew Zhang has built."
>
  <h3 class="centerer">Places My Stuff Might be Found</h3>

  <div class="centerer socials">
    {
      socials.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
        >
          <span class="iconify" data-icon={social.icon} />
        </a>
      ))
    }
  </div>

  <h1 class="centerer">Favourites</h1>
  <div class="posts-grid">
    {
      favourites.map((post) => (
        <WorkPreview
          url={post.url}
          title={post.frontmatter.title}
          tags={post.frontmatter.tags}
          description={post.frontmatter.description}
        />
      ))
    }
  </div>

  <h1 class="centerer">All Projects</h1>
  <div class="centerer tag-row">
    {tags.map((tag) => <TagCell tag={tag} base="/projects" />)}
  </div>

  <div class="posts-grid">
    {
      posts.map((post) => (
        <WorkPreview
          url={post.url}
          title={post.frontmatter.title}
          tags={post.frontmatter.tags}
          description={post.frontmatter.description}
        />
      ))
    }
  </div>
</Bloglayout>

<style>
  .socials {
    display: flex;
    gap: 1rem;
  }

  .tag-row {
    margin-bottom: 1rem;
  }
</style>

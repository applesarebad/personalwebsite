---
import Bloglayout from "../../layouts/bloglayout.astro";
import WorkPreview from "../../components/work-preview.astro";
import TagCell from "../../components/tag-cell.astro";
import { loadPosts, tagRoutes, type Post } from "../../lib/posts";

export function getStaticPaths() {
  return tagRoutes(loadPosts(import.meta.glob("../stuff/*.md", { eager: true })));
}

interface Props {
  posts: Post[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Bloglayout
  title={`${tag} | Andrew Zhang`}
  description={`Projects tagged ${tag}.`}
>
  <div class="centerer tag-row">
    Looking for: <TagCell tag={tag!} base="/projects" />
    <a href="/projects/stuff" aria-label="Clear tag filter">x</a>
  </div>

  <div class="posts-grid">
    {
      posts.map((post) => (
        <WorkPreview
          url={post.url}
          title={post.frontmatter.title}
          tags={post.frontmatter.tags}
          description={post.frontmatter.description}
        />
      ))
    }
  </div>
</Bloglayout>

<style>
  .tag-row a {
    text-decoration: none;
    color: inherit;
  }
</style>

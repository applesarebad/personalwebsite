---
import "../styles/global.css";
import ThemeInit from "../components/theme-init.astro";

const nav = [
  { label: "About", href: "/about" },
  { label: "Projects", href: "/projects/stuff" },
  { label: "Blog", href: "/blog/blablabla" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Andrew Zhang</title>
    <link rel="icon" type="image/x-icon" href="/aboutme/profilepic.png" />
    <ThemeInit />
  </head>
  <body>
    <main class="hero">
      <div class="hero__image" id="hero-image">
        <img class="sr-only" id="hero-image-img" src="" alt="" />
      </div>

      <div class="hero__panel">
        <div class="hero__panel-inner">
          <h1 class="hero__name">Andrew Zhang</h1>
          <p class="hero__tag">CS and Math at UofT </p>

          <nav class="hero__nav" aria-label="Primary">
            {nav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>

          <button class="hero__switch" id="hero-switch" type="button" aria-label="Show a different painting">
            switch painting
          </button>
        </div>
      </div>
    </main>

    <script>
      function syncHeroImage(painting) {
        const imageEl = document.getElementById("hero-image");
        const imgEl = document.getElementById("hero-image-img");
        if (!imageEl || !imgEl || !painting) return;
        imageEl.style.backgroundImage = `url(${painting.src})`;
        imgEl.src = painting.src;
        imgEl.alt = painting.alt ?? "A painting by Andrew Zhang";
      }

      if (window.__activePainting) {
        syncHeroImage(window.__activePainting);
      }
      window.addEventListener("theme-applied", (e) => syncHeroImage(e.detail));

      document.getElementById("hero-switch")?.addEventListener("click", () => {
        window.__cycleTheme?.();
      });
    </script>
  </body>
</html>

<style>
  :global(html, body) {
    margin: 0;
    height: 100%;
  }

  .hero {
    position: relative;
    height: 100vh;
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    background-color: var(--blush-deep);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero__panel {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 26%;
    background: var(--blush);
    display: flex;
    align-items: center;
    /* your latest slant — left as-is */
    clip-path: polygon(0 0, 50% 0, 70% 100%, 0 100%);
    padding: clamp(1.5rem, 3.5vw, 3rem);
  }

  .hero__panel-inner {
    animation: rise 0.7s ease-out both;
    max-width: 17rem;
  }

  .hero__name {
    margin: 0;
    font-family: Georgia, "Iowan Old Style", "Palatino Linotype", serif;
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    line-height: 1.1;
    color: var(--plum);
  }

  .hero__tag {
    margin: 0.9rem 0 1.8rem;
    font-family: "Courier New", ui-monospace, monospace;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--plum-soft);
  }

  .hero__nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .hero__nav a {
    color: var(--plum);
    text-decoration: none;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  .hero__nav a:hover,
  .hero__nav a:focus-visible {
    border-color: var(--accent-strong);
  }

  .hero__switch {
    margin-top: 2rem;
    background: none;
    border: 1px solid var(--plum-soft);
    color: var(--plum-soft);
    font-family: "Courier New", ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .hero__switch:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__panel-inner {
      animation: none;
    }
  }

  @media (max-width: 800px) {
    .hero__panel {
      width: 100%;
      height: 60%;
      inset: auto 0 0 0;
      clip-path: polygon(0 12%, 100% 0, 100% 100%, 0 100%);
      align-items: flex-start;
      padding-top: 3rem;
    }

    .hero__panel-inner {
      max-width: none;
    }

    .hero__nav {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
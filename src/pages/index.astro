---
import Base from "../layouts/base.astro";
---

<Base
  bare
  title="Andrew Zhang"
  description="Andrew Zhang — CS and Math at UofT. Writing, projects and paintings."
>
  <main class="hero">

    <div
      class="hero__image"
      id="hero-image"
      role="img"
      aria-label="A painting by Andrew Zhang"
    >
    </div>

    <div class="hero__panel">
      <div class="hero__panel-inner">
        <h1 class="hero__name">Andrew Zhang</h1>
        <p class="hero__tag">CS and Math at UofT</p>

        <nav class="hero__nav" aria-label="Main">
          <a href="/blog/blablabla">blog</a>
          <a href="/projects/stuff">projects</a>
          <a href="/about">about</a>
        </nav>

        <button
          class="hero__switch"
          id="hero-switch"
          type="button"
          aria-label="Show a different painting"
        >
          switch theme
        </button>
      </div>
    </div>
  </main>
</Base>

<script>
  interface Painting {
    src: string;
    alt?: string;
  }

  function syncHeroLabel(painting: Painting | undefined) {
    const imageEl = document.getElementById("hero-image");
    if (!imageEl || !painting) return;
    imageEl.setAttribute(
      "aria-label",
      painting.alt ?? "A painting by Andrew Zhang"
    );
  }

  syncHeroLabel(window.__activePainting);
  window.addEventListener("theme-applied", (event) =>
    syncHeroLabel((event as CustomEvent<Painting>).detail)
  );

  document.getElementById("hero-switch")?.addEventListener("click", () => {
    window.__cycleTheme?.();
  });
</script>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    height: 100%;
  }

  .hero {
    position: relative;
    height: 100vh;
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    background-color: var(--light-deep);

    background-image: var(--hero-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero__panel {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: min(400px, 35vw);
    min-width: 280px;
    background: var(--light);
    display: flex;
    align-items: center;

    clip-path: polygon(0 0, 85% 0, 100% 100%, 0 100%);
    padding: clamp(1.5rem, 3.5vw, 3rem);
  }

  .hero__panel-inner {
    width: 100%;
    max-width: 17rem;
  }

  .hero__name {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    line-height: 1.1;
    color: var(--dark);
  }

  .hero__tag {
    margin: 0.9rem 0 1.8rem;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--dark-soft);
  }

  .hero__nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .hero__nav a {
    color: var(--dark);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    padding-bottom: 0.2rem;
    transition: color 0.25s ease;
  }

  .hero__nav a:hover,
  .hero__nav a:focus-visible {
    color: var(--accent-strong);
  }

  .hero__switch {
    margin-top: 2rem;
    padding: 0;
    background: none;
    color: var(--dark-soft);
    font-family: var(--font-sans);
    border: 0;
    font-size: 1rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .hero__switch:hover {
    color: var(--accent);
  }

  @media (max-width: 800px) {
    .hero__panel {
      width: 100%;
      min-width: unset;
      height: auto;
      inset: auto 0 0 0;

      clip-path: polygon(0 0, 100% 60px, 100% 100%, 0 100%);
      align-items: flex-start;
      padding: 2.5rem 1.75rem 2rem;
    }

    .hero__panel-inner {
      max-width: none;
      width: 100%;
    }

    .hero__nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.25rem;
    }
  }
</style>

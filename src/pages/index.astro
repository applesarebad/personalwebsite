---
import "../styles/global.css";
import ThemeInit from "../components/theme-init.astro";

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Andrew Zhang</title>
    <link rel="icon" type="image/x-icon" href="/aboutme/profilepic.png" />
    <ThemeInit />
  </head>
  <body>
    <main class="hero">
      <div class="hero__image" id="hero-image">
        <img class="sr-only" id="hero-image-img" src="" alt="" />
      </div>

      <div class="hero__panel">
        <div class="hero__panel-inner">
          <h1 class="hero__name">Andrew Zhang</h1>
          <p class="hero__tag">CS and Math at UofT </p>

          <div class="hero__nav" aria-label="Primary">
            <a href="/blog/blablabla">blog</a>
    <a href="/projects/stuff">projects</a>
    <a href="/about">about</a>
          </div>

          <button class="hero__switch" id="hero-switch" type="button" aria-label="Show a different painting">
            switch theme
          </button>
        </div>
      </div>
    </main>

    <script>
      function syncHeroImage(painting) {
        const imageEl = document.getElementById("hero-image");
        const imgEl = document.getElementById("hero-image-img");
        if (!imageEl || !imgEl || !painting) return;
        imageEl.style.backgroundImage = `url(${painting.src})`;
        imgEl.src = painting.src;
        imgEl.alt = painting.alt ?? "A painting by Andrew Zhang";
      }

      if (window.__activePainting) {
        syncHeroImage(window.__activePainting);
      }
      window.addEventListener("theme-applied", (e) => syncHeroImage(e.detail));

      document.getElementById("hero-switch")?.addEventListener("click", () => {
        window.__cycleTheme?.();
      });
    </script>
  </body>
</html>

<style>
  :global(html, body) {
    margin: 0;
    height: 100%;
  }

  .hero {
    position: relative;
    height: 100vh;
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    background-color: var(--light-deep);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

.hero__panel {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: min(400px, 35vw); /* Responsive width with a minimum base */
  min-width: 280px;        /* Prevents content collapse on medium screens */
  background: var(--light);
  display: flex;
  align-items: center;
  /* Shift polygon points right to give content breathing room */
  clip-path: polygon(0 0, 85% 0, 100% 100%, 0 100%);
  padding: clamp(1.5rem, 3.5vw, 3rem);
  box-sizing: border-box;
}

.hero__panel-inner {
  animation: rise 0.1s ease-out both;
  width: 100%;
  max-width: 17rem;
}

  .hero__name {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    line-height: 1.1;
    color: var(--dark);
  }

  .hero__tag {
    margin: 0.9rem 0 1.8rem;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--dark-soft);
  }

  .hero__nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .hero__nav a {
    color: var(--dark);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    padding-bottom: 0.2rem;
    transition: color 0.25s ease;
  }

  .hero__nav a:hover,
  .hero__nav a:focus-visible {
    color: var(--accent-strong);
  }

  .hero__switch {
    margin-top: 2rem;
    background: none;
    color: var(--dark-soft);
    font-family: var(--font-mono);
    border: 0px solid var(--dark-soft);
    border-radius: 0.25rem;
    font-size: 1rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .hero__switch:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__panel-inner {
      animation: none;
    }
  }

 @media (max-width: 800px) {
  .hero__panel {
    width: 100%;
    min-width: unset;
    height: auto;
    inset: auto 0 0 0;
    /* 
      Top-left stays at 0px from top of panel.
      Top-right drops by a fixed 60px (or calc(0px + 60px)).
    */
    clip-path: polygon(0 0, 100% 60px, 100% 100%, 0 100%);
    align-items: flex-start;
    padding: 2.5rem 1.75rem 2rem;
  }

  .hero__panel-inner {
    max-width: none;
    width: 100%;
  }

  .hero__nav {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
}
</style>
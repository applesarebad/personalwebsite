---
import Bloglayout from "../../layouts/bloglayout.astro";
import PostPreview from "../../components/post-preview.astro";
import TagCell from "../../components/tag-cell.astro";
import { loadPosts, tagRoutes, type Post } from "../../lib/posts";

export function getStaticPaths() {
  return tagRoutes(loadPosts(import.meta.glob("../posts/*.md", { eager: true })));
}

interface Props {
  posts: Post[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Bloglayout
  title={`${tag} | Andrew Zhang`}
  description={`Blog posts tagged ${tag}.`}
>
  <div class="centerer tag-row">
    Looking for: <TagCell tag={tag!} base="/blog" />
    <a href="/blog/blablabla" aria-label="Clear tag filter">x</a>
  </div>

  {
    posts.map((post) => (
      <PostPreview
        url={post.url}
        title={post.frontmatter.title}
        date={post.frontmatter.date}
        tags={post.frontmatter.tags}
        description={post.frontmatter.description}
      />
    ))
  }
</Bloglayout>

<style>
  .tag-row {
    margin-bottom: 2rem;
  }

  .tag-row a {
    text-decoration: none;
    color: inherit;
  }
</style>

---
import Bloglayout from '../../layouts/bloglayout.astro';
import TagCell from '../../components/tag-cell.astro';

// Import posts with eager loading
const allPosts = Object.values(
  import.meta.glob('../posts/*.md', { eager: true })
).reverse();

const allTags = [...new Set(
  [...allPosts].flatMap((post: any) => post.frontmatter.tags ?? [])
)].sort();
---

<style>
  h1 {
    font-size: 4rem;
  }

  .post-article {
    margin-bottom: 4rem;
    padding-bottom: 3rem;
  }

  .post-article:not(:last-child) {
    border-bottom: 1px solid #e5e5e5;
  }

  .post-meta {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 1.5rem;
  }

  .tags-wrapper {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
</style>

<Bloglayout>
  <div class="centerer">
    <h1>BLOG</h1> 
  </div>

  <div class="centerer">
    {allTags.map((tag: any) => <TagCell tag={tag} />)}
  </div>

  <br><br>

  <main class="feed-container">
    {allPosts.map((post: any) => {
    const PostContent = post.Content;

    return (
      <article class="feed-post">
        <div class="post-body">
          <PostContent />
        </div>
      </article>
    );
  })}
  </main>
</Bloglayout>
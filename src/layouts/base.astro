---
import "../styles/global.css";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import ThemeInit from "../components/theme-init.astro";

interface Props {
  title?: string;
  description?: string;

  bare?: boolean;
}

const {
  title = "Andrew Zhang",
  description = "Andrew Zhang's personal site: writing, projects and paintings.",
  bare = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/aboutme/profilepic.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <ThemeInit />

    {
      !bare && (
        <script
          src="https://code.iconify.design/3/3.1.0/iconify.min.js"
          is:inline
        />
      )
    }

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-CJT5EDTM10"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-CJT5EDTM10");
    </script>
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <Header />
          <div id="words">
            <slot />
          </div>
          <Footer />
        </>
      )
    }
  </body>
</html>

<style>
  #words {
    min-height: 85vh;
  }
</style>

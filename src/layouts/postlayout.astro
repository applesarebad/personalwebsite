---
import "../styles/global.css";
import Body from "./empty.astro";
import TagCell from "../components/tag-cell.astro";
import ThemeInit from "../components/theme-init.astro";

const { frontmatter } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{frontmatter.title}</title>
    <link rel="icon" type="image/x-icon" href="/aboutme/profilepic.png" />
    <ThemeInit />
    <style>
      h1 {
        font-size: 2.75rem;
        margin-bottom: 1rem;
        padding: 0;
        color: var(--dark);
      }
      .tags {
        flex: 0 1 auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 0.5rem 0.25rem;
        width: 100%;
        margin-top: 1rem;
      }
      .title-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
    </style>
    <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  </head>
  <body>
      <article class="content">
        <div class="title-row">
          <h1>{frontmatter.title}</h1>
        </div>

        <div class="post-meta">
          <p>{frontmatter.description}</p>
          <time>{frontmatter.date} {frontmatter.lastupdate}</time>
          {frontmatter.tags && (
            <div class="tags">
              {frontmatter.tags.map((tag_: string) => (
                <TagCell tag={tag_} />
              ))}
            </div>
          )}
        </div>

        <slot />

        <br />
      </article>
  </body>
</html>
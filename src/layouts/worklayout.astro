---
import Base from "./base.astro";
import TagCell from "../components/tag-cell.astro";
import type { PostFrontmatter } from "../lib/posts";

interface Props {
  frontmatter: PostFrontmatter;

  url?: string;
}

const { frontmatter, url } = Astro.props;

const ownPath = url ?? Astro.url.pathname;
const isBlogPost = ownPath.startsWith("/posts");
const indexUrl = isBlogPost ? "/blog/blablabla" : "/projects/stuff";
const tagBase = isBlogPost ? "/blog" : "/projects";

const tags = frontmatter.tags ?? [];
---

<Base
  title={`${frontmatter.title} | Andrew Zhang`}
  description={frontmatter.description}
>
  <article class="content">
    <div class="title-row">
      <a class="back-arrow" href={indexUrl} aria-label="Back" data-back>
        <span class="iconify" data-icon="mdi:arrow-left"></span>
      </a>
      <h1>{frontmatter.title}</h1>
    </div>

    {frontmatter.description && <p class="lede">{frontmatter.description}</p>}

    <p class="dates">
      <time>{frontmatter.date} {frontmatter.lastupdate}</time>
    </p>

    {
      tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <TagCell tag={tag} base={tagBase} />
          ))}
        </div>
      )
    }

    <slot />

    <p class="centerer">
      <a class="back-arrow" href={indexUrl} aria-label="Back" data-back>
        <span class="iconify" data-icon="mdi:arrow-left"></span>
      </a>
    </p>
  </article>
</Base>

<style>
  h1 {
    font-size: 2.75rem;
    margin: 0;
    padding: 0;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .back-arrow {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--dark);
    transition: color 0.2s ease;
  }

  .back-arrow:hover {
    color: var(--accent);
  }

  .title-row .back-arrow {
    margin-left: -3rem;
  }

  @media (max-width: 60rem) {
    .title-row .back-arrow {
      margin-left: 0;
    }
  }

  .lede,
  .dates {
    margin: 0 0 1rem;
    padding: 0;
    color: var(--dark-soft);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem 0.25rem;
    width: 100%;
    margin-bottom: 1.5rem;
  }
</style>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>("a[data-back]")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        if (document.referrer && history.length > 1) {
          event.preventDefault();
          history.back();
        }
      });
    });
</script>

---
import "../styles/global.css";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import ThemeInit from "../components/theme-init.astro";
---
 
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <ThemeInit />
    <style>
      #words {
        min-height: 85vh;
      }
    </style>
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-CJT5EDTM10"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
 
      gtag("config", "G-CJT5EDTM10");
    </script>
  </head>
  <body>
    <Header />
    <div id="words">
      <slot />
    </div>
    <Footer />
  </body>
</html>